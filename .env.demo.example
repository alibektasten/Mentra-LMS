# Copy this file to .env.demo on the VPS. Never commit .env.demo or share it.
#
# 1. Set PUBLIC_ORIGIN to the exact address you will open in the browser.
#    For tomorrow's IP-only demo it is: http://YOUR_VPS_IPV4
#    Do not add a trailing slash.
PUBLIC_ORIGIN=http://YOUR_VPS_IPV4

# 2. Generate these two values on the VPS with:
#    openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_A_64_CHARACTER_HEX_VALUE
JWT_SECRET=REPLACE_WITH_A_DIFFERENT_64_CHARACTER_HEX_VALUE

# 3. Create an API key at platform.openai.com and paste it here.
#    This key stays only on the VPS; it is not sent to the browser.
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5.4-mini

# Optional system-level administrator, available at /login (without an org slug).
# Use a new, strong password. The seeded organisation accounts are documented
# in DEMO_DEPLOYMENT.md.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
