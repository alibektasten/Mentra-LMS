# Copy to .env.production on the server. Never commit the real file.
# DNS for DOMAIN must point to the server before starting Caddy.
DOMAIN=lms.example.edu
ACME_EMAIL=ops@example.edu

# Generate separately: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_A_64_CHARACTER_HEX_VALUE
JWT_SECRET=REPLACE_WITH_A_DIFFERENT_64_CHARACTER_HEX_VALUE

# Server-only OpenAI credentials.
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5.4-mini
AI_DAILY_REQUEST_LIMIT=50

SUPER_ADMIN_EMAIL=admin@example.edu
SUPER_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD

# Optional Google sign-in. The callback must be registered in Google Cloud.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# One compressed PostgreSQL dump every 24 hours, retained locally for 14 days.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
