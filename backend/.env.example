SERVER_PORT=
SERVER_MODE=
CORS_ALLOWED_ORIGINS=

DB_DSN=
DB_PASSWORD=
DB_MAX_OPEN_CONNS=
DB_MAX_IDLE_CONNS=
DB_CONN_MAX_LIFETIME_MINUTES=

JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_MINUTES=

# AI provider: ollama (local) or openai (hosted). Keep OPENAI_API_KEY in this
# server-side file only; never expose it as a NEXT_PUBLIC_ variable.
AI_PROVIDER=ollama
# Maximum AI requests per authenticated account per UTC day. Set 0 to disable
# the application-level quota (not recommended for paid providers).
AI_DAILY_REQUEST_LIMIT=50

OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_OUTPUT_TOKENS=1200

# Google OAuth (optional). Create a Web application client in Google Cloud.
# The redirect URI must exactly match GOOGLE_OAUTH_REDIRECT_URL.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3000
